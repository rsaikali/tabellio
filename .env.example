# tabellio reads exactly three environment variables. Each is a fallback for the
# matching parse() argument; an explicit argument always wins.
# Copy to .env and export these in your shell before running `python -m tabellio`.
# (tabellio does not load .env itself -- use your shell or a loader.)

TABELLIO_PROVIDER=gemini          # gemini | openai | nim | anthropic | ollama
TABELLIO_KEY=                     # your provider API key (BYOK). Not needed for ollama.
TABELLIO_MODEL=                   # optional: override the provider's default model

# Example image for manual checks (public-domain register only).
# TABELLIO_SAMPLE=data/1.jpg
