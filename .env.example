# tabellio is BYOK. If you do not pass api_key to parse(), it falls back to
# $TABELLIO_API_KEY, then the provider's own variable below.
# Copy to .env and fill the one provider you use, OR just export it in your shell.

# TABELLIO_API_KEY=          # generic override, wins over the provider vars

# GEMINI_API_KEY=            # or GOOGLE_API_KEY
# OPENAI_API_KEY=
# NVIDIA_API_KEY=            # nim backend (or NVIDIA_NIM_API_KEY)
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# Example image to run manual checks against (public-domain register only).
# TABELLIO_SAMPLE=data/1.jpg
