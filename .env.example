# tabellio is BYOK: the library never reads these itself.
# They are only a convenience for local scripts, examples and manual testing.
# Copy to .env and fill the one provider you use.

# GEMINI_API_KEY=
# OPENAI_API_KEY=
# NVIDIA_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# Example image to run manual checks against (public-domain register only).
# TABELLIO_SAMPLE=data/sample-act.jpg
